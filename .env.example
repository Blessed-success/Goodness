# Environment Configuration for Goodness eCommerce Platform
# Copy this to .env and update with your actual values

# =============================================
# DATABASE CONFIGURATION
# =============================================
DATABASE_URL=postgresql://user:password@localhost:5432/blessednet

# =============================================
# AUTHENTICATION & SECURITY
# =============================================
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long
FLASK_DEBUG=false
FLASK_ENV=production
SECRET_KEY=your-app-secret-key-change-this-in-production

# Admin Account Defaults (for initial setup)
DEFAULT_ADMIN_EMAIL=admin@nexus.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# =============================================
# PAYMENT GATEWAY (PAYSTACK)
# =============================================
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# =============================================
# CORS CONFIGURATION
# =============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000

# =============================================
# RATE LIMITING (via Flask-Limiter)
# =============================================
# Global limits: 200 requests/day, 50 requests/hour per IP
# Endpoint-specific limits:
# - Auth endpoints: 10 requests/minute (brute force prevention)
# - Admin operations: 10 requests/minute
# - Credential management: 5-10 requests/minute
# - Cart operations: 20 requests/minute
# - Read operations: 50 requests/minute

# =============================================
# CREDENTIAL MANAGEMENT SETTINGS
# =============================================
CREDENTIAL_PASSWORD_MIN_LENGTH=8
CREDENTIAL_PASSWORD_HISTORY_COUNT=3
CREDENTIAL_LOCKOUT_ATTEMPTS=5
CREDENTIAL_LOCKOUT_DURATION_MINUTES=30
CREDENTIAL_PASSWORD_EXPIRY_DAYS=90

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=Nexus Wholesale Hub
APP_VERSION=1.0
APP_ENVIRONMENT=production

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================
# LOCATION SYSTEM
# =============================================
ENABLE_LOCATION_AUTO_DETECTION=false
