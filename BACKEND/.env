# BlessedNet Wholesale Hub - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== DATABASE CONFIGURATION =====
# PostgreSQL database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://blessednet_user:secure_password@localhost:5432/blessednet

# ===== JWT AUTHENTICATION =====
# Secret key for general app signing and session tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-secret-key-change-this-immediately
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-immediately

# Default admin credentials
ADMIN_EMAIL=prolificever360@gmail.com
ADMIN_PASSWORD=Greatness@360
ADMIN_USERNAME=urieltopherio

# ===== FLASK CONFIGURATION =====
# Set to False in production
FLASK_DEBUG=True

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5500

# ===== PAYSTACK PAYMENT INTEGRATION =====
# Get these from https://dashboard.paystack.com/settings/api-keys
# Test Keys (for development/testing)
# User-provided placeholder values for Paystack integration
PAYSTACK_PUBLIC_KEY=pk_test_6f38d5771635c61a6cd56cae0acd551a978d8b36
PAYSTACK_SECRET_KEY=sk_test_702da459814340fdc426696b9f89658ca76f674d

# ===== WHATSAPP INTEGRATION =====
# Your WhatsApp Business Account Number (with country code, no + or spaces)
# Example: 233502683544 (for Ghana)
WHATSAPP_BUSINESS_PHONE=233502683544

# WhatsApp Business Phone Number ID (from Meta/Facebook Business Manager)
WHATSAPP_PHONE_NUMBER_ID=970779426118591

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=1476685143319800

# WhatsApp API Token (from Meta/Facebook Business Manager)
WHATSAPP_API_TOKEN=EAAXPpeHB5WABRSjdr7WZBJs33BClIHdKaY2aDUSbJhEaDzXrZCdFKwDKJGwsQgCJqqxX9xZBZBZBOUhUz5PNWhjogQZBIkm4rCh5PJAtVJZC9W9mUy9xNpjlHdzpaziIe0ZC1cuPZAw47ZBDFQTBZADod4fj58zQYxDGZAl4ZChm9sTT8xXC2LZAx7ZCkXopy0cd9IG2cWzMwZDZD

# WhatsApp Webhook Verify Token (set this yourself, keep it secret)
WHATSAPP_VERIFY_TOKEN=Bestnet360ever

# WhatsApp API Key (if using third-party service like Twilio)
# Leave empty if using Meta Business API
WHATSAPP_API_KEY=your_whatsapp_api_key_optional

# ===== EMAIL CONFIGURATION (Optional) =====
# For sending notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== APPLICATION SETTINGS =====
# Application environment
ENVIRONMENT=development

# API Host and Port
API_HOST=0.0.0.0
API_PORT=5000

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

# ===== SECURITY =====
# Rate limiting settings
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
