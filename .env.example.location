# Environment Configuration for Location-Based Access Control System
# Copy this to .env and update with your actual values

# =============================================
# DATABASE CONFIGURATION
# =============================================
DATABASE_URL=postgresql://user:password@localhost:5432/blessednet

# =============================================
# AUTHENTICATION & SECURITY
# =============================================
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long
FLASK_DEBUG=false
FLASK_ENV=production

# =============================================
# LOCATION-BASED ACCESS CONTROL
# =============================================
# Default behavior for location system
# When a region or city is marked as inactive, users cannot:
# - Add to cart
# - Create orders
# - Initialize payments
# 
# All inactive locations are completely restricted unless admin overrides

# By default, all 16 Ghana regions and 97 cities are ACTIVE
# Admins can toggle regions/cities ON/OFF via the admin panel

# Region list included:
# - Greater Accra, Ashanti, Central, Northern, Upper East, Upper West
# - Volta, Eastern, Western, Bono, Bono East, Ahafo, Savannah, North East, Oti, Wese

# =============================================
# PAYMENT GATEWAY (PAYSTACK)
# =============================================
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# =============================================
# CORS CONFIGURATION
# =============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# =============================================
# RATE LIMITING (via Flask-Limiter)
# =============================================
# Global limits: 200 requests/day, 50 requests/hour per IP
# 
# Endpoint-specific limits:
# - Auth endpoints: 10 requests/minute (brute force prevention)
# - Location selection: 10 requests/minute
# - Payment endpoints: 10 requests/minute
# - Order creation: 5 requests/minute
# - Admin operations: 10 requests/minute
# - Cart operations: 20 requests/minute
# - Read operations: 50 requests/minute

# =============================================
# LOCATION SYSTEM - ADMIN SETTINGS
# =============================================

# IMPORTANT: After first deployment, run setup:
# cd BACKEND
# python setup_locations.py
#
# This will:
# 1. Create regions and cities tables
# 2. Populate all 16 Ghana regions
# 3. Populate 97 major cities
# 4. Mark all as ACTIVE by default
#
# Then access the admin panel and toggle locations as needed

# Auto-Detection Settings (Optional)
# Set to true to enable IP-based location detection
ENABLE_LOCATION_AUTO_DETECTION=false

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=Nexus Wholesale Hub
APP_VERSION=1.0
APP_ENVIRONMENT=production

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================
# NOTES
# =============================================
#
# Location System Behavior:
# 
# 1. INACTIVE Region: All users in that region cannot access products
# 2. INACTIVE City: Users in that specific city cannot access products
# 3. Both must be ACTIVE for user to access services
#
# Example:
# - If "Greater Accra" region is INACTIVE: No one from Greater Accra can buy
# - If "Accra" city is INACTIVE: Only Accra users cannot buy, others in region can
#
# User Experience:
# - On login: User selects their region/city
# - Selection saved to: User profile + localStorage
# - On purchase: System checks if their location is active
# - If inactive: Shows "Service not available in your location"
# - User can select different location anytime
#
# Admin Controls:
# - Navigate to Admin Dashboard > Locations tab
# - Toggle regions ON/OFF
# - Toggle cities ON/OFF individually
# - Changes apply immediately
# - No downtime required
#
# Security:
# - Location check happens server-side (cannot bypass)
# - Rate limits prevent abuse
# - JWT required for sensitive operations
# - All validations use database (source of truth)
#
